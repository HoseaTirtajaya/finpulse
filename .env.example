# Optional AI — Gemini is the free default; OpenAI/Anthropic are swappable
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Market data — Yahoo (free) for equities/FX/indices; crypto uses CoinGecko
# Optional CoinGecko Demo API key (higher rate limits). Rankings work keyless.
COINGECKO_API_KEY=

# Optional: sync watchlist across devices (leave empty for localStorage only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ingest store (Neon Postgres free tier). When unset, UI uses live RSS fan-out.
DATABASE_URL=

# Protects /api/cron/ingest (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
