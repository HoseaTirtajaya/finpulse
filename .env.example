# Optional AI — Gemini is the free default; OpenAI/Anthropic are swappable
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Market data — yahoo (free) by default; later: finnhub | polygon
MARKET_PROVIDER=yahoo
FINNHUB_API_KEY=
POLYGON_API_KEY=

# Optional: sync watchlist across devices (leave empty for localStorage only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
